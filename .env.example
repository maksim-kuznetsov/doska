# Образец переменных окружения производственного развёртывания.
# Скопируйте файл в .env и задайте собственные значения; .env в репозиторий не попадает.
# Подробная инструкция — deploy/DEPLOY.md.

POSTGRES_DB=doska
POSTGRES_USER=doska
# Замените на длинный случайный пароль: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Домен для сертификата Let's Encrypt и адрес для уведомлений ACME.
DOMAIN=doska.example.com
ACME_EMAIL=admin@example.com

# Публичный адрес сайта: из него строятся ссылки в письмах. Без завершающего слэша.
App__PublicBaseUrl=https://doska.example.com

# Почта production. Пока домен отправителя не подтверждён, работает файловый режим:
# письма сохраняются в Email__OutboxPath и видны администратору в разделе «Письма (outbox)».
# После подтверждения домена верните Email__Mode=Smtp и заполните SMTP-параметры ниже.
Email__Mode=File
Email__OutboxPath=/srv/doska/outbox

# SMTP-параметры нужны только при Email__Mode=Smtp.
Email__Host=
Email__Port=587
Email__UserName=
Email__Password=
Email__From=no-reply@doska.example.com
Email__UseStartTls=true